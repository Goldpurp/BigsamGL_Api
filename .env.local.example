# Copy to .env.local. scripts/run-local.sh reads this ignored file.
# Prevent the macOS host configuration watcher from spinning before Kestrel
# starts. dotnet-watch still handles source-code hot reload normally.
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false

ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=55432;Database=bigsamgl;Username=bigsamgl;Password=<LOCAL_POSTGRES_PASSWORD>;Maximum Pool Size=30;Timeout=5;Command Timeout=30;SSL Mode=Disable"
Jwt__Secret="<GENERATE_AT_LEAST_32_RANDOM_BYTES>"
Jwt__Issuer="BigsamGL.Api.Local"
Jwt__Audience="BigsamGL.LocalClients"
PublicSite__BaseUrl="http://127.0.0.1:3001"

# Optional one-time local administrator. Remove the password after creation.
BootstrapAdmin__FullName="BiGSAM Local Administrator"
BootstrapAdmin__Email="<LOCAL_ADMIN_EMAIL>"
BootstrapAdmin__Password="<LOCAL_ADMIN_PASSWORD>"
BootstrapAdmin__EmployeeNumber="BGL-ADMIN-001"
BootstrapAdmin__BranchCode="GLOBAL"

# Local-only integrations and operational records never run in Production.
Seed__LocalOperationalData=true
LocalSeed__CustomerEmail="amina.bello@bigsamgl.test"
LocalSeed__CustomerPassword="<LOCAL_CUSTOMER_PASSWORD>"
LocalSeed__StaffPassword="<LOCAL_STAFF_PASSWORD>"
Integrations__Mode="Local"
MscTracking__Mode="Local"
MscTracking__AutomaticSyncEnabled=false
CarrierWebhooks__SharedSecret="local-only-carrier-webhook-secret-change-before-production"
