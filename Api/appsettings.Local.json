{
  "AllowedHosts": "localhost;127.0.0.1",
  "Runtime": {
    "EnableSwagger": true,
    "UseHttpsRedirection": false,
    "ResponseCompression": true,
    "DefaultRequestTimeoutSeconds": 30,
    "ReportRequestTimeoutSeconds": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "InitializeOperationalData": true,
    "TrustPrivateNetwork": true,
    "MinPoolSize": 2,
    "MaxPoolSize": 30,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "ConnectionIdleLifetimeSeconds": 300
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3001",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "http://localhost:4174",
      "http://127.0.0.1:4174"
    ]
  },
  "PublicSite": {
    "BaseUrl": "http://127.0.0.1:3001"
  },
  "DataProtection": {
    "KeysPath": ".local/data-protection-keys"
  },
  "Seed": {
    "ReferenceData": true,
    "LocalOperationalData": true
  },
  "Integrations": {
    "Mode": "Local"
  },
  "CarrierWebhooks": {
    "SharedSecret": "local-only-carrier-webhook-secret-change-before-production"
  },
  "ExchangeRates": {
    "ProviderTimeoutSeconds": 3,
    "AllowConfiguredFallback": true,
    "FallbackRates": {
      "GBP_NGN": 2200,
      "GBP_CNY": 9.3,
      "GBP_USD": 1.28,
      "GBP_EUR": 1.17,
      "USD_NGN": 1600,
      "USD_CNY": 7.2
    }
  },
  "MscTracking": {
    "Mode": "Local",
    "AutomaticSyncEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
