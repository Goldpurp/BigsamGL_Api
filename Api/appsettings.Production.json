{
  "AllowedHosts": "api.bigsamgl.com;*.onrender.com",
  "Runtime": {
    "EnableSwagger": false,
    "UseHttpsRedirection": false,
    "ResponseCompression": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "InitializeOperationalData": false,
    "TrustPrivateNetwork": false
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "TrustPlatformProxy": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": [
      "https://bigsamgl.com",
      "https://www.bigsamgl.com",
      "https://dashboard.bigsamgl.com"
    ]
  },
  "PublicSite": {
    "BaseUrl": "https://bigsamgl.com"
  },
  "Seed": {
    "ReferenceData": false,
    "LocalOperationalData": false
  },
  "Integrations": {
    "Mode": "Live"
  },
  "ExchangeRates": {
    "AllowConfiguredFallback": false
  },
  "MscTracking": {
    "Mode": "Live",
    "AutomaticSyncEnabled": true
  }
}
