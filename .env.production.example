# Configure in the production secret manager. Never deploy a .env file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__DefaultConnection="Host=<PRIVATE_DB_HOST>;Port=5432;Database=bigsamgl;Username=<LEAST_PRIVILEGED_USER>;Password=<PRODUCTION_PASSWORD>;Maximum Pool Size=80;Timeout=10;Command Timeout=30;SSL Mode=VerifyFull;Root Certificate=<CA_PATH>"
Jwt__Secret="<PRODUCTION_RANDOM_SECRET_AT_LEAST_32_BYTES>"
Jwt__Issuer="BigsamGL.Api"
Jwt__Audience="BigsamGL.Web"
AllowedHosts="api.bigsamgl.com;*.onrender.com"
Cors__AllowedOrigins__0="https://bigsamgl.com"
Cors__AllowedOrigins__1="https://www.bigsamgl.com"
Cors__AllowedOrigins__2="https://dashboard.bigsamgl.com"
PublicSite__BaseUrl="https://bigsamgl.com"

Runtime__EnableSwagger=false
Runtime__UseHttpsRedirection=false
Database__ApplyMigrationsOnStartup=false
Database__InitializeOperationalData=false
Database__TrustPrivateNetwork=false
ForwardedHeaders__Enabled=true
ForwardedHeaders__TrustPlatformProxy=false
ForwardedHeaders__ForwardLimit=1
ForwardedHeaders__KnownProxies__0="<EXACT_REVERSE_PROXY_IP>"

DataProtection__KeysPath="/var/data/bigsamgl-keys"
DataProtection__CertificateBase64="<BASE64_ENCODED_PFX>"
DataProtection__CertificatePassword="<PFX_PASSWORD>"
CarrierWebhooks__SharedSecret="<RANDOM_WEBHOOK_SECRET>"

ExchangeRates__BaseUrl="https://api.frankfurter.dev"
ExchangeRates__AllowConfiguredFallback=false
Integrations__Mode="Live"
Integrations__BaseUrl="<LIVE_INTEGRATION_BROKER_HTTPS_URL>"
Integrations__ApiKey="<LIVE_INTEGRATION_BROKER_API_KEY>"
Integrations__TimeoutSeconds=15
MscTracking__Mode="Live"
MscTracking__EventsUrlTemplate="<MSC_ISSUED_DCSA_EVENTS_URL_TEMPLATE>"
MscTracking__OAuthTokenUrl="<MSC_ISSUED_OAUTH_URL>"
MscTracking__ClientId="<MSC_CLIENT_ID>"
MscTracking__ClientSecret="<MSC_CLIENT_SECRET>"
MscTracking__Scope="<MSC_SCOPE>"
MscTracking__SubscriptionKeyHeader="<MSC_HEADER_IF_REQUIRED>"
MscTracking__SubscriptionKey="<MSC_KEY_IF_REQUIRED>"
MscTracking__AutomaticSyncEnabled=true
Seed__ReferenceData=false
Seed__LocalOperationalData=false
BootstrapAdmin__Email=""
BootstrapAdmin__Password=""
